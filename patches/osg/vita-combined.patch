+            for (int i = n - 1; i >= 0 && ok; --i)
+            {
+                const osg::StateSet* ss = chain[i]->getStateSet();
+                if (!ss)
+                    continue;
+                const osg::StateSet::AttributeList& al = ss->getAttributeList();
+                for (osg::StateSet::AttributeList::const_iterator it = al.begin(); it != al.end(); ++it)
+                {
+                    std::map<osg::StateAttribute::TypeMemberPair, AV>::iterator ex = attrs.find(it->first);
