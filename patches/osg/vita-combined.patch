+#ifdef __vita__
+// Draw-dispatch replay: capture resolved GL bindings once for static
+// single-primset VBO geometry, then draw with ~8 direct GL calls instead
+// of the VAS/dispatcher machinery. The VAS is marked dirty afterwards so
+// the next normal-path draw rebuilds its cached bindings.
+extern "C" { extern uint32_t osgprof_replayed; }
+
+namespace
+{
+    bool vitaCaptureChan(osg::Geometry::VitaDrawCache::Chan& c, const osg::Array* array, unsigned int contextID,
+        osg::ref_ptr<osg::Referenced>& keepAlive, unsigned int& vboID)
+    {
+        if (!array)
+        {
+            c.on = false;
+            return true;
+        }
+        const osg::BufferObject* bo = array->getBufferObject();
+        if (!bo)
+            return false;
+        osg::GLBufferObject* glbo = bo->getGLBufferObject(contextID);
+        if (!glbo || glbo->getGLObjectID() == 0)
+            return false;
+        if (vboID == 0)
+        {
+            vboID = glbo->getGLObjectID();
+            keepAlive = glbo;
+        }
+        else if (vboID != glbo->getGLObjectID())
+            return false; // multi-VBO geometry: keep normal path
+        c.on = true;
+        c.size = array->getDataSize();
+        c.type = array->getDataType();
+        c.normalized = array->getNormalize() ? 1 : 0;
+        c.ptr = reinterpret_cast<const unsigned char*>(0) + glbo->getOffset(array->getBufferIndex());
+        return true;
+    }
+}
+
+extern "C" uint32_t vita_replay_epoch; // osgUtil/RenderLeaf.cpp
+
+bool osg::Geometry::vitaFastDraw(osg::RenderInfo& renderInfo) const
+{
+    osg::State& state = *renderInfo.getState();
+    VitaDrawCache& dc = _vitaDrawCache;
+
+    // The app bumped the epoch after releasing GL objects: every cached
+    // buffer id is suspect. Drop the cache; the normal path draws (and
+    // recompiles buffers as needed) until re-capture next frame.
+    if (dc.valid && dc.epoch != vita_replay_epoch)
+        dc.valid = false;
+
+    if (!dc.valid)
+    {
+        // Qualify + capture. Failure leaves valid=false: retried next frame
+        // (buffer objects exist only after the first normal draw).
+        if (_primitives.size() != 1 || _containsDeprecatedData || !_vertexArray.valid())
+            return false;
+        if (!_vertexAttribList.empty() || _secondaryColorArray.valid() || _fogCoordArray.valid())
+            return false;
+        if (_texCoordList.size() > 1)
+            return false;
+        if (_normalArray.valid() && _normalArray->getBinding() != osg::Array::BIND_PER_VERTEX)
+            return false;
+        if (_colorArray.valid() && _colorArray->getBinding() != osg::Array::BIND_PER_VERTEX)
+            return false;
+        const osg::PrimitiveSet* ps = _primitives[0].get();
+        unsigned int primGLType = 0;
+        switch (ps->getType())
+        {
+            case osg::PrimitiveSet::DrawElementsUBytePrimitiveType: primGLType = GL_UNSIGNED_BYTE; break;
+            case osg::PrimitiveSet::DrawElementsUShortPrimitiveType: primGLType = GL_UNSIGNED_SHORT; break;
+            case osg::PrimitiveSet::DrawElementsUIntPrimitiveType: primGLType = GL_UNSIGNED_INT; break;
+            default:
+                return false;
+        }
+        const unsigned int contextID = state.getContextID();
+        const osg::BufferObject* ebo = ps->getBufferObject();
+        if (!ebo)
+            return false;
+        osg::GLBufferObject* glebo = ebo->getGLBufferObject(contextID);
+        if (!glebo || glebo->getGLObjectID() == 0)
+            return false;
+
+        unsigned int vboID = 0;
+        VitaDrawCache tmp;
+        if (!vitaCaptureChan(tmp.chan[0], _vertexArray.get(), contextID, tmp.vboRef, vboID))
+            return false;
+        if (!vitaCaptureChan(tmp.chan[1],
+                (_normalArray.valid() && _normalArray->getBinding() == osg::Array::BIND_PER_VERTEX)
+                    ? _normalArray.get()
+                    : nullptr,
+                contextID, tmp.vboRef, vboID))
+            return false;
+        if (!vitaCaptureChan(tmp.chan[2],
+                (_colorArray.valid() && _colorArray->getBinding() == osg::Array::BIND_PER_VERTEX)
+                    ? _colorArray.get()
+                    : nullptr,
+                contextID, tmp.vboRef, vboID))
+            return false;
+        if (!vitaCaptureChan(tmp.chan[3], _texCoordList.empty() ? nullptr : _texCoordList[0].get(), contextID,
+                tmp.vboRef, vboID))
+            return false;
+
+        // Aliased generic attribute locations (the port renders with
+        // vertex attribute aliasing on; classic gl*Pointer feeds nothing).
+        tmp.chan[0].slot = state.getVertexAlias()._location;
+        tmp.chan[1].slot = state.getNormalAlias()._location;
+        tmp.chan[2].slot = state.getColorAlias()._location;
+        tmp.chan[3].slot = state.getTexCoordAliasList().empty() ? -1 : state.getTexCoordAliasList()[0]._location;
+        if (tmp.chan[3].on && tmp.chan[3].slot < 0)
+            return false;
+
+        tmp.vboID = vboID;
+        tmp.eboRef = glebo;
+        tmp.eboID = glebo->getGLObjectID();
+        tmp.primMode = ps->getMode();
+        tmp.primType = primGLType;
+        tmp.primCount = ps->getNumIndices();
+        tmp.primIndices = reinterpret_cast<const unsigned char*>(0) + glebo->getOffset(ps->getBufferIndex());
+        tmp.epoch = vita_replay_epoch;
+        tmp.valid = true;
+        dc = tmp;
+    }
+
+    osg::GLExtensions* ext = state.get<osg::GLExtensions>();
+    ext->glBindBuffer(GL_ARRAY_BUFFER, dc.vboID);
+    for (int i = 0; i < 4; ++i)
+    {
+        const VitaDrawCache::Chan& c = dc.chan[i];
+        if (c.slot < 0)
+            continue;
+        if (c.on)
+        {
+            ext->glEnableVertexAttribArray(c.slot);
+            ext->glVertexAttribPointer(c.slot, c.size, c.type, c.normalized, 0, c.ptr);
+        }
+        else
+            ext->glDisableVertexAttribArray(c.slot);
+    }
+
+    ext->glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, dc.eboID);
+    glDrawElements(dc.primMode, dc.primCount, dc.primType, dc.primIndices);
+
+    ++osgprof_replayed;
+    return true;
+}
