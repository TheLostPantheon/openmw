+                        && !(ov & osg::StateAttribute::PROTECTED))
+                        continue;
+                    attrs[it->first] = AV(it->second.first.get(), ov);
+                }
+                const osg::StateSet::ModeList& ml = ss->getModeList();
+                for (osg::StateSet::ModeList::const_iterator it = ml.begin(); it != ml.end(); ++it)
+                {
+                    const unsigned int v = it->second;
+                    if (v & osg::StateAttribute::INHERIT)
+                        continue;
+                    std::map<osg::StateAttribute::GLMode, std::pair<bool, unsigned int>>::iterator ex
+                        = modes.find(it->first);
+                    if (ex != modes.end() && (ex->second.second & osg::StateAttribute::OVERRIDE)
+                        && !(v & osg::StateAttribute::PROTECTED))
+                        continue;
+                    modes[it->first] = std::make_pair((v & osg::StateAttribute::ON) != 0, v);
+                }
+                const osg::StateSet::UniformList& ul = ss->getUniformList();
+                for (osg::StateSet::UniformList::const_iterator it = ul.begin(); it != ul.end(); ++it)
+                {
+                    std::map<std::string, std::pair<const osg::Uniform*, unsigned int>>::iterator ex
+                        = uniforms.find(it->first);
+                    const unsigned int ov = it->second.second;
+                    if (ex != uniforms.end() && (ex->second.second & osg::StateAttribute::OVERRIDE)
+                        && !(ov & osg::StateAttribute::PROTECTED))
+                        continue;
+                    uniforms[it->first] = std::make_pair(it->second.first.get(), ov);
+                }
+                const osg::StateSet::TextureAttributeList& tl = ss->getTextureAttributeList();
+                if (tl.size() > 2)
+                {
+                    ok = false;
+                    break;
+                }
+                for (unsigned int u = 0; u < tl.size() && ok; ++u)
+                {
+                    for (osg::StateSet::AttributeList::const_iterator it = tl[u].begin(); it != tl[u].end(); ++it)
+                    {
+                        const osg::StateAttribute::Type t = it->first.first;
+                        if (t == osg::StateAttribute::TEXTURE)
+                        {
+                            const unsigned int ov = it->second.second;
+                            if (tex[u].first && (tex[u].second & osg::StateAttribute::OVERRIDE)
+                                && !(ov & osg::StateAttribute::PROTECTED))
