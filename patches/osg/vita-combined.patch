+    // After replay draws, the VAS caches are stale: null them and force
+    // known GL client state so the next normal-path draw rebinds cleanly.
+    void vitaResyncVAS(osg::State& state)
+    {
+        // The replay path binds generic attributes + buffers directly;
+        // disable what it may have left on and null the VAS caches so the
+        // next normal-path draw rebuilds from scratch.
+        osg::GLExtensions* ext = state.get<osg::GLExtensions>();
+        const int slots[4] = { state.getVertexAlias()._location, state.getNormalAlias()._location,
+            state.getColorAlias()._location,
+            state.getTexCoordAliasList().empty() ? -1 : state.getTexCoordAliasList()[0]._location };
+        for (int i = 0; i < 4; ++i)
+            if (slots[i] >= 0)
+                ext->glDisableVertexAttribArray(slots[i]);
+        ext->glBindBuffer(GL_ARRAY_BUFFER, 0);
+        ext->glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, 0);
+        osg::VertexArrayState* vas = state.getCurrentVertexArrayState();
+        if (!vas)
+            return;
+        const auto reset = [](osg::VertexArrayState::ArrayDispatch* d) {
+            if (d)
+            {
+                d->array = 0;
+                d->modifiedCount = 0xffffffff;
+                d->active = false;
+            }
+        };
+        reset(vas->_vertexArray.get());
+        reset(vas->_normalArray.get());
+        reset(vas->_colorArray.get());
+        for (unsigned i = 0; i < vas->_texCoordArrays.size(); ++i)
+            reset(vas->_texCoordArrays[i].get());
+        for (unsigned i = 0; i < vas->_vertexAttribArrays.size(); ++i)
+            reset(vas->_vertexAttribArrays[i].get());
+        vas->_activeDispatchers.clear();
+        vas->_previous_activeDispatchers.clear();
+        vas->setCurrentVertexBufferObject(0);
+        vas->setCurrentElementBufferObject(0);
+    }
