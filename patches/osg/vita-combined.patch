+            if (ok)
+            {
+                for (std::map<osg::StateAttribute::TypeMemberPair, AV>::const_iterator it = attrs.begin();
+                     it != attrs.end(); ++it)
+                    fs->attrs.push_back(osg::State::VitaFlatState::AttrEntry(it->first, it->second.first));
+                for (std::map<osg::StateAttribute::GLMode, std::pair<bool, unsigned int>>::const_iterator it
+                     = modes.begin();
+                     it != modes.end(); ++it)
+                    fs->modes.push_back(osg::State::VitaFlatState::ModeEntry(it->first, it->second.first));
+                for (std::map<std::string, std::pair<const osg::Uniform*, unsigned int>>::const_iterator it
+                     = uniforms.begin();
+                     it != uniforms.end(); ++it)
+                    fs->uniforms.push_back(it->second.first);
+                fs->texture[0] = tex[0].first;
+                fs->texture[1] = tex[1].first;
+                fs->usable = true;
+            }
+        }
+        fs->frameStamp = frame;
+        return fs->usable ? fs : 0;
+    }
