+                return 0; // don't cache: variance can flip back
+            sig = sig * 31u + (unsigned int)(uintptr_t)ss
+                + (unsigned int)(ss->getAttributeList().size() * 8191 + ss->getModeList().size() * 127
+                    + ss->getUniformList().size())
