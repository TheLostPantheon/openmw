+    // Build (or revalidate) the composed chain state for a graph node.
+    // Returns null if the chain is dynamic or uses features the flat
+    // path doesn't model (TexMat/TexGen, >2 texture units).
+    osg::State::VitaFlatState* vitaGetFlat(StateGraph* rg, unsigned int frame)
+    {
+        osg::State::VitaFlatState* fs = static_cast<osg::State::VitaFlatState*>(rg->_vitaFlat.get());
+        if (fs && fs->frameStamp == frame)
