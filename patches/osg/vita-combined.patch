+                        }
+                        else if (t == osg::StateAttribute::TEXMAT || t == osg::StateAttribute::TEXGEN
+                            || t == osg::StateAttribute::POINTSPRITE)
+                        {
+                            ok = false; // functional texture state we don't model
+                            break;
+                        }
+                        // TexEnv etc: ignored by the FFP-replacement shaders.
+                    }
+                }
+            }
